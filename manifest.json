{
  "manifest_version": 3,
  "name": "Syndicate Review AI Agent",
  "version": "1.0",
  "description": "Réponses intelligentes aux avis clients Amazon/Shopify via IA.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.com/*", "https://*.amazon.fr/*", "https://*.shopify.com/*"],
      "js": ["content.js"]
    }
  ]
}
